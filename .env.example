# Formspree form ID — where the "Get notified" emails are collected.
#
# To wire up email collection:
#   1. Create a free form at https://formspree.io (free tier: 50 submissions/mo)
#   2. Copy the ID from the endpoint URL: https://formspree.io/f/{ID}
#   3. Paste it below, then save this file as `.env` (or run: cp .env.example .env)
#
# The form will show "Email signup is not wired up yet" until this is set.
VITE_FORMSPREE_ID=your_form_id_here
